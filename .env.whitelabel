# =============================================================================
# BRAND — the unbranded build (`npm run build:white-label`)
# -----------------------------------------------------------------------------
# Every value blank, so the built artifact contains no name, no tagline and no
# mark — not hidden, absent. Vite substitutes these at build time, and the
# marked-up blocks in index.html are dropped outright (see the brand plugin in
# vite.config.ts).
#
# To ship under somebody else's name, fill these in rather than emptying them:
# the provenance line on an exported spreadsheet is what tells whoever opens it
# in a year what wrote it.
# =============================================================================
VITE_BRAND_NAME=
VITE_BRAND_SHORT=
VITE_BRAND_TAGLINE=
VITE_BRAND_MARK=off
