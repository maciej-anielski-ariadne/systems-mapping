# =============================================================================
# BRAND — the app's own name, in one place
# -----------------------------------------------------------------------------
# Read by Vite (dev, build and the test run) and substituted into both the
# bundle and index.html. Nothing in assets/ or index.html hardcodes the name, so
# a rebrand is a change to this file and nothing else.
#
# For a build carrying no name at all, see .env.whitelabel and
# `npm run build:white-label`. That is why these values live here rather than as
# defaults in the source: a default in the source would still be IN the bundle,
# findable by anyone who looked, which is not the same as removing it.
# =============================================================================

# The full name. Browser tab, the Learn library's heading, the welcome dialog,
# and the provenance line on anything the app exports.
VITE_BRAND_NAME=Ariadne Maps

# The short name, used mid-sentence in the lessons ("Ariadne autosaves the
# current map…"). Blank falls back to "This app", which reads correctly in
# every one of those sentences.
VITE_BRAND_SHORT=Ariadne

# Shown under the name on the empty state.
VITE_BRAND_TAGLINE=Map cause and effect

# "off" removes the brand mark, the wordmark and the favicon from the build
# rather than hiding them.
VITE_BRAND_MARK=on
